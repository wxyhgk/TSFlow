UMA_ENVIRONMENT=development
UMA_LOG_LEVEL=INFO
UMA_API_PREFIX=/api/v1
UMA_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
# UMA_CHECKPOINT_DIR=/absolute/path/to/model-assets/UMA/checkpoints
UMA_WORKER_ENABLED=false
# Keep the UMA child process and its model cache alive across jobs. 0 means no
# task-count retirement; the process exits after 30 minutes without a job.
UMA_WORKER_MAX_TASKS_PER_PROCESS=0
UMA_WORKER_IDLE_TIMEOUT_SECONDS=1800
# auto prefers MPS for TRIC optimization and always uses CPU for the final result.
UMA_OPTIMIZATION_DEVICE=auto
